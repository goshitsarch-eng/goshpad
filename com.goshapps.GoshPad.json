{
  "app-id": "com.goshapps.GoshPad",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.9",
  "sdk": "org.kde.Sdk",
  "command": "goshpad",
  "branch": "stable",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--talk-name=org.freedesktop.portal.Desktop"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/doc",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "goshpad",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INSTALL_PREFIX=/app"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
